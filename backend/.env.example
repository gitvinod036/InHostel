# Backend environment variables (do NOT commit real secrets)
DJANGO_SECRET_KEY=replace-with-strong-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
USE_SQLITE_FALLBACK=True
# If you set USE_SQLITE_FALLBACK=False, provide MySQL credentials below
DB_NAME=replace-with-db-name
DB_USER=replace-with-db-user
DB_PASSWORD=replace-with-db-password
DB_HOST=127.0.0.1
DB_PORT=3306

# JWT
JWT_SIGNING_KEY=replace-with-jwt-secret

# OTP provider configuration (optional)
OTP_PROVIDER=mock
OTP_API_KEY=
OTP_SENDER_ID=
OTP_MAX_ATTEMPTS=5
OTP_EXPIRES_MINUTES=5

# Google
GOOGLE_CLIENT_ID=

# Email configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=replace-with-default-from-email
